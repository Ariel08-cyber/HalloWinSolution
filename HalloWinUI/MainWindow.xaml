<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="HalloWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HalloWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:HalloWinUI.Views"
    Title="HalloWinUI"
    mc:Ignorable="d">

    <NavigationView
        x:Name="NavView"
        AlwaysShowHeader="False"
        BackRequested="NavView_BackRequested"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        SelectionChanged="NavView_SelectionChanged">

        <NavigationView.MenuItems>
            <!--  Tag : nom de la classe de la page  -->
            <NavigationViewItem
                Content="Les maisons"
                IsSelected="True"
                Tag="HalloWinUI.Views.MaisonsPage">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEC06;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="Les enfants" Tag="HalloWinUI.Views.EnfantsPage">
                <!--  Utilisation d'une icône personnalisée  -->
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="People" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Frame
            x:Name="ContentFrame"
            Navigated="ContentFrame_Navigated"
            NavigationFailed="ContentFrame_NavigationFailed" />

    </NavigationView>
</Window>
