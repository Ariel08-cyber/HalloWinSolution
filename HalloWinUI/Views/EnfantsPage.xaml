<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HalloWinUI.Views.EnfantsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HalloWinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:HalloWinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            AutomationProperties.HeadingLevel="Level1"
            FontSize="28"
            FontWeight="SemiBold"
            Text="Enfants" />

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8">
            <Button Click="btn_AjouterEnfantClick" Content="Ajouter un enfant" />
            <Button Click="btn_ModifierEnfantClick" Content="Modifier" />
            <Button Click="btn_SupprimerEnfantClick" Content="Supprimer" />
        </StackPanel>

        <ListView
            Grid.Row="2"
            AutomationProperties.Name="Liste des enfants"
            ItemsSource="{x:Bind ViewModel.Enfants, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.EnfantSelectionne, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:EnfantViewModel">
                    <TextBlock
                        Padding="8"
                        FontSize="18"
                        Text="{x:Bind Nom, Mode=OneWay}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
