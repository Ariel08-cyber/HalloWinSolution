<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HalloWinUI.Views.MaisonsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HalloWinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:HalloWinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Titre de la page  -->
        <TextBlock
            AutomationProperties.HeadingLevel="Level1"
            FontSize="28"
            FontWeight="SemiBold"
            Text="Maisons d'Halloween" />

        <!--  Formulaire d'ajout d'une maison  -->
        <StackPanel
            Grid.Row="1"
            MaxWidth="520"
            HorizontalAlignment="Left"
            Spacing="12">
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Ajouter une maison" />

            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Ligne 1 : numéro + rue  -->
                <StackPanel>
                    <TextBox
                        Header="Numéro"
                        PlaceholderText="123"
                        Text="{x:Bind ViewModel.NouvelleMaison.NumeroCivique, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ItemsView Foreground="Coral" ItemsSource="{x:Bind ViewModel.NouvelleMaison.GetErrors('NumeroCivique'), Mode=OneWay}">
                        <ItemsView.Resources>
                            <SolidColorBrush x:Key="ItemContainerPointerOverBackground" Color="Transparent" />
                        </ItemsView.Resources>
                    </ItemsView>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.ColumnSpan="2">
                    <TextBox
                        Header="Rue"
                        PlaceholderText="Rue des Fantômes"
                        Text="{x:Bind ViewModel.NouvelleMaison.Rue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ItemsView Foreground="Coral" ItemsSource="{x:Bind ViewModel.NouvelleMaison.GetErrors('Rue'), Mode=OneWay}">
                        <ItemsView.Resources>
                            <SolidColorBrush x:Key="ItemContainerPointerOverBackground" Color="Transparent" />
                        </ItemsView.Resources>
                    </ItemsView>

                </StackPanel>

                <!--  Ligne 2 : ville + code postal  -->

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                    <TextBox
                        Header="Ville"
                        PlaceholderText="Gatineau"
                        Text="{x:Bind ViewModel.NouvelleMaison.Ville, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ItemsView Foreground="Coral" ItemsSource="{x:Bind ViewModel.NouvelleMaison.GetErrors('Ville'), Mode=OneWay}">
                        <ItemsView.Resources>
                            <SolidColorBrush x:Key="ItemContainerPointerOverBackground" Color="Transparent" />
                        </ItemsView.Resources>
                    </ItemsView>

                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBox
                        Header="Code postal"
                        MaxLength="7"
                        PlaceholderText="J8X 1A1"
                        Text="{x:Bind ViewModel.NouvelleMaison.CodePostal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ItemsView Foreground="Coral" ItemsSource="{x:Bind ViewModel.NouvelleMaison.GetErrors('CodePostal'), Mode=OneWay}">
                        <ItemsView.Resources>
                            <SolidColorBrush x:Key="ItemContainerPointerOverBackground" Color="Transparent" />
                        </ItemsView.Resources>
                    </ItemsView>

                </StackPanel>
                <!--  Ligne 3 : bouton  -->
                <Button
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Click="btn_AjouterMaisonClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Ajouter" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!--  Liste des maisons  -->
        <TextBlock
            Grid.Row="2"
            AutomationProperties.HeadingLevel="Level2"
            FontSize="20"
            FontWeight="SemiBold"
            Text="Liste des maisons" />

        <GridView
            Grid.Row="3"
            AutomationProperties.Name="Liste des maisons"
            ItemsSource="{x:Bind ViewModel.Maisons, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.MaisonSelectionee, Mode=TwoWay}"
            SelectionMode="Single">

            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,12,12" />
                </Style>
            </GridView.ItemContainerStyle>

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:MaisonViewModel">
                    <Border
                        Width="280"
                        Padding="16"
                        Background="GhostWhite"
                        BorderBrush="#FFFFCC99"
                        BorderThickness="2">
                        <StackPanel Spacing="12">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{x:Bind AdresseComplete, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <CheckBox Content="Signaler" IsChecked="True" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <Button
            Grid.Row="4"
            Background="DarkOrange"
            Click="btn_SupprimerMaisonClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                <TextBlock Text="Supprimer" />
            </StackPanel>
        </Button>
    </Grid>
</Page>
