<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HalloWinUI.Views.FormulaireEnfantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HalloWinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel
        MaxWidth="520"
        Padding="16"
        HorizontalAlignment="Left"
        Spacing="16">
        <TextBlock
            AutomationProperties.HeadingLevel="Level1"
            FontSize="28"
            FontWeight="SemiBold"
            Text="{x:Bind ViewModel.Titre, Mode=OneWay}" />

        <StackPanel>
            <TextBox
                Header="Nom"
                PlaceholderText="Nom de l'enfant"
                Text="{x:Bind ViewModel.EnfantEdit.Nom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ItemsView Foreground="Coral" ItemsSource="{x:Bind ViewModel.EnfantEdit.GetErrors('Nom'), Mode=OneWay}">
                <ItemsView.Resources>
                    <SolidColorBrush x:Key="ItemContainerPointerOverBackground" Color="Transparent" />
                </ItemsView.Resources>
            </ItemsView>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Click="btn_EnregistrerClick" Content="Enregistrer" />
            <Button Click="btn_AnnulerClick" Content="Annuler" />
        </StackPanel>
    </StackPanel>
</Page>
